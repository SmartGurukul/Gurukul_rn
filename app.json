{
  "expo": {
    "name": "Smart Gurukul",
    "slug": "gurukul-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gurukul.rn",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "upi",
          "phonepe",
          "gpay"
        ]
      },
      "associatedDomains": [
        "applinks:api.smartgurukul.org"
      ]
    },
    "android": {
      "package": "com.gurukul.rn",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.smartgurukul.org",
              "pathPrefix": "/track/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Smart Gurukul uses your camera for video calls."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Smart Gurukul uses your location to confirm you're at the school when self-marking attendance, and to show parents where the school bus is during a bus driver's trip.",
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7C3AED",
          "defaultChannel": "default"
        }
      ],
      "./plugins/withCleartextTraffic.js",
      "./plugins/withUpiIntentQueries.js",
      "expo-localization",
      "@react-native-google-signin/google-signin",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Smart Gurukul uses your microphone for video calls."
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "./plugins/withNoMediaPlaybackFgs.js"
    ],
    "extra": {
      "eas": {
        "projectId": "f610c224-f96d-4706-a22c-38f27170b00c"
      },
      "playIntegrityCloudProjectNumber": "855182407063"
    },
    "owner": "yashcodes105",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f610c224-f96d-4706-a22c-38f27170b00c"
    }
  }
}
